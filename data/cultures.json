    "_learning": "How the player and the rival Houses learn (systems/languages.js). Immersion: a day spent where a language is spoken (in its settlement, or its realm's land) gains `immersion` fluency, scaled by `pace` for the band you are in (it gets slower as you get better), less with a translator doing the talking. Talking to people gains `talk` (a few times a day). A tutor's lesson in a town costs `tutor.cost` and gives `tutor.gain` in the town's tongue or another its scholars teach. Old saves: the player speaks the tongue where they stand and is `legacyFluency` in those of realms they are known to.",
    "learning": {
        "immersion": 0.7,
        "pace": [[0, 1.0], [20, 0.8], [50, 0.5], [80, 0.25]],
        "translatorDamp": 0.5,
        "talk": 0.6,
        "talkPerDay": 3,
        "tutor": { "cost": 18, "gain": 5, "perDay": 1 },
        "legacyFluency": 60,
        "legacyReputation": 10
    },
    "_translator": "An interpreter hired in a town: speaks its tongue, yours, and one or two more of the realms about. A hiring fee, a daily wage (they leave when unpaid), and a comprehension of `fluency` in what they speak.",
    "translator": { "hire": 25, "wage": 4, "fluency": 70, "extraTongues": [1, 2] },
    "_effects": "What not understanding costs (by your level in the tongue spoken where you are). trade: added to the trade bonus (buy and sell). audience: the fluency (or a translator) a lord's audience needs. dialog: which conversation choices need which level.",
    "effects": {
        "trade": { "none": -0.12, "broken": -0.05, "conversational": 0, "fluent": 0.02 },
        "audience": 50,
        "dialog": {
            "none": ["farewell", "trade", "give_gift", "threat"],
            "broken": ["farewell", "trade", "give_gift", "threat", "ask_location", "ask_quest", "accept_quest", "decline_quest", "repay_favour", "ask_rumor"]
        }
    },
    "_realms": "Courts: a realm's court speaks its own tongue and learns the tongues of the realms it deals with (`courtLearn` a contact). Diplomacy between courts with no common tongue goes harder (`diplomacy` by the best level either court has in the other's tongue); same family helps.",
    "realms": {
        "courtLearn": 1.5,
        "diplomacy": { "none": -3, "broken": -1, "conversational": 0, "fluent": 1, "same": 2 }
    },
    "_rivals": "Rival Houses on business in a town of another tongue: they hire a translator for `fee` when the purse allows (else trade at `badDeal` and win half the favour at court), and learn `learn` fluency a visit.",
    "rivals": { "fee": 12, "badDeal": 0.12, "learn": 3 },

