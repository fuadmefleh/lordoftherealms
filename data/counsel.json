{
    "_comment": "The Steward's Counsel (src/systems/counsel.js): the advisor's rules. Each rule names a reader (Counsel.READERS) that returns facts; the fact fields fill the {placeholders} in 'text'. group: threat | opportunity | goal. severity: critical | warning | notice | info (a fact may override it). priority orders items of equal severity (a fact may add a 'boost'). panel: the ActionMenu panel the item's button opens (ui/actionMenu/counsel.js COUNSEL_PANELS); items with a map hex also get a 'show on map' button. params: per-rule tunables passed to the reader. max: items kept per rule (config.maxPerRule otherwise). heavy: whole-world scans, read at most once a day. enabled:false switches a rule off.",
    "config": {
        "maxPerRule": 3,
        "nearby": 6,
        "briefCount": 3,
        "briefMinSeverity": "notice"
    },
    "rules": [
        { "id": "holding_siege", "group": "threat", "reader": "holdingSieges", "priority": 100, "severity": "warning", "icon": "🏰", "panel": "holdingSieges",
          "text": "{name} is besieged by {enemy}: {stores} days of food left", "params": { "criticalStores": 7 } },
        { "id": "revolt", "group": "threat", "reader": "revolt", "priority": 98, "severity": "critical", "icon": "🔥", "panel": "royalVassals",
          "text": "The revolt of {leader} rages ({hosts} rebel hosts in the field)" },
        { "id": "faction_brewing", "group": "threat", "reader": "factions", "priority": 90, "severity": "warning", "icon": "🗡️", "panel": "royalVassals",
          "text": "A faction under {leader} demands {demand} (threat {threat}%){when}", "params": { "warnShare": 0.8 } },
        { "id": "holding_unrest", "group": "threat", "reader": "holdingUnrest", "priority": 80, "severity": "warning", "icon": "😠", "panel": "holding", "heavy": true,
          "text": "Unrest in {name} stands at {unrest}: rebellion looms", "params": { "warnAt": 60, "riskAt": 75 } },
        { "id": "war_host", "group": "threat", "reader": "warHosts", "priority": 88, "severity": "warning", "icon": "⚔️", "panel": "realmWars",
          "text": "{host} of {realm} marches{target}, {dist} hexes away (strength {strength})", "params": { "radius": 10, "criticalRadius": 4 } },
        { "id": "war_ultimatum", "group": "threat", "reader": "ultimatums", "priority": 85, "severity": "warning", "icon": "📜", "panel": "realmWars",
          "text": "{realm} demands {tribute} gold tribute: {left} to answer" },
        { "id": "deadly_disease", "group": "threat", "reader": "ailments", "priority": 95, "severity": "critical", "icon": "🤒", "panel": "physician",
          "text": "{name} ({stage}) can kill you: see a physician", "params": { "allDiseases": false } },
        { "id": "starvation", "group": "threat", "reader": "hunger", "priority": 96, "severity": "warning", "icon": "🍞", "panel": "inventory",
          "text": "Only {food} days of food left in your pack", "params": { "lowDays": 3 } },
        { "id": "ship_provisions", "group": "threat", "reader": "shipProvisions", "priority": 84, "severity": "warning", "icon": "⚓", "panel": "fleet",
          "text": "The {name} has provisions for {days} days", "params": { "days": 3 } },
        { "id": "heat", "group": "threat", "reader": "heat", "priority": 70, "severity": "notice", "icon": "🔥", "panel": "underworld",
          "text": "Heat {heat} in {realm}: {level}" },
        { "id": "petition_expiring", "group": "threat", "reader": "petitions", "priority": 60, "severity": "warning", "icon": "⚖️", "panel": "petitions",
          "text": "The petition \"{title}\" lapses in {left}", "params": { "days": 3 } },
        { "id": "unpaid", "group": "threat", "reader": "unpaid", "priority": 82, "severity": "warning", "icon": "💸", "panel": "travelParty",
          "text": "{name} {what}", "params": { "mercLoyalty": 45 } },
        { "id": "companion_desertion", "group": "threat", "reader": "companionDesertion", "priority": 78, "severity": "warning", "icon": "🚶", "panel": "travelParty",
          "text": "{name} is close to leaving you (approval {approval})", "params": { "margin": 8 } },
        { "id": "nemesis_near", "group": "threat", "reader": "nemesis", "priority": 75, "severity": "warning", "icon": "💀", "panel": "rivals",
          "text": "Your nemesis {name} is {dist} hexes away", "params": { "radius": 8, "criticalRadius": 3 } },
        { "id": "saga_turning", "group": "threat", "reader": "sagas", "priority": 72, "severity": "warning", "icon": "📜", "panel": "sagas",
          "text": "{saga}: \"{chapter}\" turns in {left} near {place}", "params": { "days": 5, "radius": 10, "beastRadius": 5 } },
        { "id": "outlaw_lair", "group": "threat", "reader": "outlawThreats", "priority": 66, "severity": "notice", "icon": "🏕️", "panel": "outlawLairs",
          "text": "Outlaws of {lair} under {leader} prey on the country {dist} hexes from {place}{riding}", "params": { "radius": 9, "nearRadius": 4 }, "max": 2 },
        { "id": "lean_season", "group": "threat", "reader": "leanSeason", "priority": 55, "severity": "notice", "icon": "❄️", "panel": "inventory",
          "text": "The lean weeks {when} and you carry only {food} food", "params": { "ahead": 15, "minFood": 10 } },
        { "id": "discovery_contest", "group": "threat", "reader": "discoveryContests", "priority": 74, "severity": "warning", "icon": "🧭", "panel": "discoveries",
          "text": "{realm} contests your claim to {name}: {left}" },
        { "id": "blockade", "group": "threat", "reader": "blockade", "priority": 65, "severity": "warning", "icon": "🚢", "panel": "fleet",
          "text": "{realm} is blockaded by {by}" },

        { "id": "forward_due", "group": "threat", "reader": "forwardDue", "priority": 83, "severity": "warning", "icon": "📜", "panel": "mpContracts",
          "text": "Deliver {qty} {good} to {town} by day {due} ({left} left) or forfeit a quarter", "params": { "days": 5 } },
        { "id": "warehouse_rent", "group": "threat", "reader": "warehouseRent", "priority": 62, "severity": "notice", "icon": "📦", "panel": "mpWarehouse",
          "text": "You owe {owed} gold rent on your store-room in {town}" },
        { "id": "spoiling_stock", "group": "threat", "reader": "spoilingStock", "priority": 52, "severity": "notice", "icon": "🦴", "panel": "mpWarehouse",
          "text": "Your {qty} {good} in {town} spoil {pct}% a week: sell them soon", "params": { "weekly": 0.05, "minQty": 10, "spoilMult": 0.5 }, "max": 2 },
        { "id": "works_at_risk", "group": "threat", "reader": "worksAtRisk", "priority": 64, "severity": "notice", "icon": "🏭", "panel": "merchantPrince",
          "text": "Your works in {town}: {why}", "params": { "repBelow": -20, "condBelow": 0.6 }, "max": 2 },
        { "id": "works_short_hands", "group": "threat", "reader": "worksShortHands", "priority": 58, "severity": "notice", "icon": "🔨", "panel": "townPeople",
          "text": "Your works in {town}: {why}", "params": { "below": 0.85 }, "max": 2 },
        { "id": "property_hands", "group": "threat", "reader": "propertyHands", "priority": 46, "severity": "notice", "icon": "👷", "panel": "townPeople",
          "text": "Your {name} near {town} is short of hands: {why}", "params": { "below": 0.85, "wageAbove": 1.4 }, "max": 2 },
        { "id": "holding_idle", "group": "threat", "reader": "holdingIdle", "priority": 66, "severity": "notice", "icon": "✊", "panel": "townPeople", "heavy": true,
          "text": "{name}: {why}", "params": { "idleAt": 0.1, "criticalAt": 0.2 }, "max": 2 },
        { "id": "market_fair", "group": "opportunity", "reader": "fairs", "priority": 42, "severity": "info", "icon": "🎪", "panel": "merchantPrince",
          "text": "The {name} at {town} {when}: the stalls buy dearer and sell cheaper", "params": { "radius": 12, "ahead": 6 } },
        { "id": "contract_ready", "group": "opportunity", "reader": "contracts", "priority": 70, "severity": "notice", "icon": "📦", "panel": "company",
          "text": "You carry {qty} {good} for the contract at {town} ({pay} gold)" },
        { "id": "cheap_harvest", "group": "opportunity", "reader": "cheapFood", "priority": 40, "severity": "info", "icon": "🌾", "panel": "treasury",
          "text": "Harvest prices: food is {pct}% cheaper than usual, and dearer by winter", "params": { "good": "grain", "threshold": -0.2, "minGold": 50 } },
        { "id": "outlaw_target", "group": "opportunity", "reader": "outlawTargets", "priority": 47, "severity": "info", "icon": "⚔️", "panel": "outlawLairs",
          "text": "{lair}, {what}, lies {dist} hexes away: scout it, storm it, or strike at its chief", "params": { "radius": 12 }, "max": 1 },
        { "id": "delve_near", "group": "opportunity", "reader": "delveSites", "priority": 45, "severity": "info", "icon": "🕳️",
          "text": "{site} lies {dist} hexes away, waiting to be delved", "params": { "radius": 5 }, "max": 1 },
        { "id": "bounty", "group": "opportunity", "reader": "bounties", "priority": 50, "severity": "info", "icon": "🎯", "panel": "bounties",
          "text": "The bounty board in {town} has {n} bounties to take" },
        { "id": "heir_of_age", "group": "opportunity", "reader": "heirs", "priority": 60, "severity": "notice", "icon": "🧒", "panel": "child",
          "text": "{name} ({age}) has come of age: find them a match or a court" },
        { "id": "royal_match", "group": "opportunity", "reader": "royalMatch", "priority": 65, "severity": "notice", "icon": "💍", "panel": "child", "max": 1,
          "text": "A royal match for {name} with {royal} of {realm} is within reach" },
        { "id": "edict_slot", "group": "opportunity", "reader": "edictSlots", "priority": 55, "severity": "info", "icon": "📜", "panel": "royalEdicts",
          "text": "{free} edict slot{s} {stand} empty at court" },
        { "id": "claim_press", "group": "opportunity", "reader": "claims", "priority": 62, "severity": "notice", "icon": "👑", "panel": "claims",
          "text": "Your claim on {realm} ({strength}) is strong enough to press" },
        { "id": "tournament", "group": "opportunity", "reader": "tournament", "priority": 35, "severity": "info", "icon": "🏆", "panel": "tournament",
          "text": "You could hold a tournament in {town} ({fee} gold entry)", "params": { "minGold": 300, "cooldown": 10 } },
        { "id": "quest_near", "group": "opportunity", "reader": "quests", "priority": 58, "severity": "notice", "icon": "📜", "panel": "quests",
          "text": "{title} is {pct}% done", "params": { "minProgress": 0.75 } },
        { "id": "loan_default", "group": "threat", "reader": "loanDefault", "priority": 95, "severity": "warning", "icon": "🧾", "panel": "bank",
          "text": "{lender}: {overdue} days overdue on {owed}g; {next} {when}" },
        { "id": "loan_due", "group": "threat", "reader": "loanDue", "priority": 72, "severity": "notice", "icon": "💸", "panel": "bank", "max": 1,
          "text": "Your loans take {due}g a day and you hold {gold}g: {days} days before you miss a payment", "params": { "warnDays": 5 } },
        { "id": "debt_warrant", "group": "threat", "reader": "debtWarrant", "priority": 74, "severity": "warning", "icon": "⛓️", "panel": "bank",
          "text": "The debtors' prison waits for you in {realm} ({amount}g written off): make good the debt or keep out of its towns" },
        { "id": "bank_risk", "group": "threat", "reader": "bankRisk", "priority": 68, "severity": "notice", "icon": "🏦", "panel": "bank",
          "text": "{bank} holds {amount}g of yours and {why}", "params": { "lowReserve": 0.45 } },
        { "id": "bond_risk", "group": "threat", "reader": "bondRisk", "priority": 50, "severity": "notice", "icon": "📉", "panel": "bank",
          "text": "Your {amount}g bond with {realm} is at risk: the crown {why}", "params": { "ratio": 0.8 } },
        { "id": "patronage_offer", "group": "threat", "reader": "patronageOffers", "priority": 70, "severity": "notice", "icon": "🎭", "panel": "patronage",
          "text": "{rival} courts {name}: match it ({counter}g) or lose them in {left}" },
        { "id": "great_work_stalled", "group": "threat", "reader": "greatWorkStalled", "priority": 55, "severity": "notice", "icon": "🏗️", "panel": "patronage",
          "text": "The {work} at {place} stands still: {why}" },
        { "id": "wonder_race", "group": "threat", "reader": "wonderRace", "priority": 60, "severity": "notice", "icon": "⏳", "panel": "patronage",
          "text": "{realm} races you for the {work}: theirs is {pct}% built" },
        { "id": "great_work_supply", "group": "opportunity", "reader": "greatWorkSupply", "priority": 45, "severity": "notice", "icon": "🧱", "panel": "patronage",
          "text": "The {work} at {place} awaits goods and gold for its {stage}" },
        { "id": "idle_client", "group": "opportunity", "reader": "idleClients", "priority": 35, "severity": "info", "icon": "🎨", "panel": "patronage",
          "text": "{name}, your {prof}, has been idle {idle}: commission a work", "params": { "minIdle": 3 } },
        { "id": "discovery_rumour", "group": "opportunity", "reader": "discoveryRumours", "priority": 42, "severity": "info", "icon": "🗺️", "panel": "discoveries",
          "text": "{how} uncharted land beyond the known world", "max": 2 },
        { "id": "escort_job", "group": "opportunity", "reader": "escortJobs", "priority": 44, "severity": "info", "icon": "🛡️",
          "text": "{house} would pay {pay}g for an escort: the {cargo} {carrier} from {from} to {to}, {dist} hexes off{danger}", "params": { "radius": 4 }, "max": 1 },

        { "id": "house_ambition", "group": "goal", "reader": "ambition", "priority": 50, "severity": "info", "icon": "🏛️", "panel": "house",
          "text": "{ambition} ({done}/{total}): next, {next}" },
        { "id": "next_trait", "group": "goal", "reader": "nextTrait", "priority": 40, "severity": "info", "icon": "✨", "panel": "character",
          "text": "{name} is {pct}% earned", "params": { "min": 0.5 } },
        { "id": "hunter_rank", "group": "goal", "reader": "hunterRank", "priority": 30, "severity": "info", "icon": "🎯", "panel": "deeds",
          "text": "{n} more captures to the rank of {title}" },
        { "id": "guild_rank", "group": "goal", "reader": "guildRank", "priority": 30, "severity": "info", "icon": "🗝️", "panel": "deeds",
          "text": "{n} more guild standing to rise to {title}" },
        { "id": "legacy", "group": "goal", "reader": "legacy", "priority": 20, "severity": "info", "icon": "📖", "panel": "deeds", "heavy": true,
          "text": "Legacy {score}: {rank}{next}" }
    ]
}
