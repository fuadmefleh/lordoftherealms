{
    "_note": "Jobs done in person on the street map (systems/mapTasks.js, ui/innerMapTasks.js). Each job is one of the templates; 'jobs' sets a job's own spots and wording, 'byStat' covers jobs not listed. Spots: 'doors' are building types ('*' any, 'house'), 'props' are town-prop id prefixes. parHours is how long a good worker takes, in game hours (one real minute is an hour). Glyphs are ui/icons.js names.",
    "templates": {
        "haul":    { "trips": [3, 5], "parHours": 2.5, "workSeconds": 1.2, "noun": "load", "glyph": "crate", "dropGlyph": "satchel" },
        "work":    { "count": [3, 5], "parHours": 2.5, "workSeconds": 3, "verb": "Work", "glyph": "hammer" },
        "deliver": { "count": [3, 5], "parHours": 2, "workSeconds": 0.6, "glyph": "seal" },
        "cry":     { "count": [3, 4], "parHours": 2.5, "workSeconds": 4, "crowdRadius": 6, "glyph": "speech", "item": "bell" },
        "tally":   { "count": [3, 4], "parHours": 2, "workSeconds": 1.5, "glyph": "ledger" },
        "gather":  { "count": [4, 6], "parHours": 2.5, "workSeconds": 2, "glyph": "wheat" },
        "herd":    { "count": [3, 4], "parHours": 3, "glyph": "sheep" },
        "catch":   { "count": [3, 5], "parHours": 2.5, "fleeRadius": 4, "glyph": "paw" },
        "patrol":  { "count": [4, 5], "parHours": 3, "workSeconds": 1, "glyph": "shield", "item": "lantern" },
        "bout":    { "parHours": 1, "glyph": "swords" }
    },
    "byStat": {
        "strength":     { "template": "haul" },
        "stamina":      { "template": "deliver" },
        "charisma":     { "template": "cry" },
        "intelligence": { "template": "tally" },
        "stealth":      { "template": "catch" },
        "combat":       { "template": "patrol" }
    },
    "jobs": {
        "farm_hand":        { "template": "haul", "item": "sack", "from": { "props": ["tp_field", "tp_sack", "tp_hay"], "doors": ["barn", "farm"] }, "to": { "doors": ["barn", "granary", "house"] }, "noun": "sack of grain", "glyph": "sack", "say": "Carry the grain sacks from the fields to the barn." },
        "stable_boy":       { "template": "work", "item": "bucket", "at": { "doors": ["stable", "barn"], "props": ["tp_hay", "tp_bucket"] }, "verb": "Muck out", "glyph": "bucket", "say": "Muck out the stalls and fetch fresh straw." },
        "well_digger":      { "template": "work", "item": "shovel", "at": { "ground": "town" }, "verb": "Dig", "glyph": "pickaxe", "count": [3, 4], "workSeconds": 4, "say": "Dig the trial pits where the dowser marked." },
        "woodcutter":       { "template": "work", "at": { "trees": true, "props": ["tp_logs", "tp_lumber", "tp_firewood"] }, "verb": "Chop", "glyph": "axe", "say": "Chop and stack firewood for the hearths." },
        "shepherd":         { "template": "herd", "say": "The flock has strayed. Find them and bring them back to the fold." },
        "herb_picker":      { "template": "gather", "item": "herbs", "glyph": "wheat", "verb": "Pick", "say": "Gather the healer's herbs from the meadows round the village." },
        "tannery_hand":     { "template": "work", "at": { "props": ["tp_barrel", "tp_barrels", "tp_bucket"] }, "verb": "Scrape", "glyph": "bucket", "say": "Scrape the hides and turn them in the pits." },
        "smith_striker":    { "template": "work", "item": "hammer", "at": { "doors": ["blacksmith"], "props": ["tp_logs", "tp_crate"] }, "verb": "Strike", "glyph": "pickaxe", "say": "Strike where the smith taps: heats at the forge and the stock round the smithy." },
        "brewhouse_hand":   { "template": "haul", "item": "sack", "from": { "props": ["tp_sacks", "tp_sack"], "doors": ["granary", "warehouse"] }, "to": { "doors": ["tavern", "inn", "brewery"] }, "noun": "sack of malt", "glyph": "sack", "say": "Carry the malt to the brewhouse vats." },
        "physicians_aide":  { "template": "deliver", "item": "vial", "to": { "doors": ["house"] }, "glyph": "wheat", "verb": "Tend", "say": "Take the physician's draughts round the sick in their houses." },
        "dock_worker":      { "template": "haul", "from": { "props": ["tp_crate", "tp_barrel", "tp_sacks"], "doors": ["warehouse"] }, "to": { "props": ["tp_stall"], "doors": ["marketplace", "warehouse"] }, "noun": "crate", "say": "Unload the wagons: crates from the warehouse to the market stalls." },
        "courier":          { "template": "deliver", "item": "parcel", "from": { "doors": ["post_house", "guildhall", "marketplace", "town_hall"] }, "to": { "doors": ["house"] }, "say": "Run the parcels round town before the bells." },
        "mason_helper":     { "template": "haul", "item": "bricks", "from": { "props": ["tp_lumber", "tp_logs", "tp_crate"], "doors": ["warehouse", "blacksmith"] }, "to": { "doors": ["house", "town_hall", "church"] }, "noun": "hod of bricks", "say": "Carry bricks and mortar to the builders." },
        "tavern_bouncer":   { "template": "patrol", "at": { "doors": ["tavern", "inn", "roadhouse"] }, "count": [3, 3], "foe": "drunk", "say": "Keep the peace round the taverns tonight." },
        "market_crier":     { "template": "cry", "say": "Cry the merchants' wares at the busy corners." },
        "scribe_assistant": { "template": "tally", "at": { "props": ["tp_crate", "tp_sacks", "tp_barrel", "tp_stall"] }, "report": { "doors": ["guildhall", "town_hall", "marketplace", "post_house", "warehouse"] }, "say": "Count the stock at the stores and report the tally." },
        "rat_catcher":      { "template": "catch", "at": { "doors": ["granary", "warehouse", "tavern", "bakery", "house"] }, "say": "Rats in the cellars. Corner them before they bolt." },
        "night_watch":      { "template": "patrol", "foe": "cutpurse", "say": "Walk the watch round the town and deal with any trouble." },
        "warehouse_guard":  { "template": "patrol", "at": { "doors": ["warehouse", "granary", "bank", "mint"] }, "count": [3, 4], "foe": "thief", "say": "Guard the merchants' stores." },
        "cargo_hauler":     { "template": "haul", "item": "bale", "from": { "props": ["tp_crate", "tp_barrels", "tp_sacks"], "doors": ["warehouse", "granary"] }, "to": { "doors": ["marketplace", "warehouse", "bank", "guildhall"] }, "noun": "bale", "trips": [4, 5], "say": "Move the goods between the market districts." },
        "herald":           { "template": "cry", "say": "Read the royal proclamation at the square and the crossroads." },
        "arena_fighter":    { "template": "bout", "foe": "champion", "say": "An exhibition bout in the square. Give them a show." },
        "tax_collector":    { "template": "deliver", "to": { "doors": ["house"] }, "glyph": "coins", "verb": "Knock", "say": "Knock on the doors that owe and collect what's due." },
        "tutor":            { "template": "tally", "at": { "props": ["tp_crate", "tp_stall", "tp_sacks"] }, "report": { "doors": ["manor", "house"] }, "say": "Take the children round the market counting, then hear them recite." },
        "pit_fighter":      { "template": "bout", "foe": "bruiser", "say": "Bare knuckles behind the tavern. Win, or at least stand." },
        "spy_errand":       { "template": "deliver", "item": "letter", "count": [1, 1], "sneak": true, "to": { "doors": ["house", "manor", "guildhall"] }, "say": "Deliver the sealed letter. Don't let the watch see you." },
        "sowing_hand":      { "template": "gather", "item": "grain_sack", "glyph": "wheat", "verb": "Sow", "say": "Broadcast seed along the plowed fields." },
        "flood_bank":       { "template": "haul", "item": "sack", "from": { "props": ["tp_sacks", "tp_sack"] }, "to": { "ground": "edge" }, "noun": "sandbag", "glyph": "sack", "say": "Carry sandbags out to the banks." },
        "camp_sutler":      { "template": "deliver", "item": "sack", "from": { "doors": ["warehouse", "granary", "marketplace"] }, "to": { "doors": ["barracks", "guard_tower", "house"] }, "say": "Run provisions out to the soldiers' billets." },
        "haymaker":         { "template": "work", "item": "scythe", "at": { "props": ["tp_field", "tp_hay", "tp_haystack"], "ground": "edge" }, "verb": "Scythe", "glyph": "wheat", "say": "Scythe the hay and stack it." },
        "harvest_reaper":   { "template": "work", "item": "scythe", "at": { "props": ["tp_field"], "ground": "edge" }, "verb": "Reap", "glyph": "wheat", "count": [4, 5], "say": "Bring in the grain with the reaping gang." },
        "grape_picker":     { "template": "gather", "glyph": "bread", "verb": "Pick", "say": "Strip the orchards before the frost." },
        "granary_loader":   { "template": "haul", "item": "sack", "from": { "props": ["tp_sacks", "tp_sack", "tp_field"] }, "to": { "doors": ["granary", "mill", "warehouse"] }, "noun": "sack", "glyph": "sack", "say": "Haul the new harvest up into the granary." },
        "snow_clearer":     { "template": "work", "at": { "roads": true }, "verb": "Shovel", "glyph": "snowflake", "say": "Dig the streets and square out of the drifts." },
        "woodcutter_winter": { "template": "haul", "from": { "trees": true, "props": ["tp_logs", "tp_firewood"] }, "to": { "doors": ["house", "tavern", "inn"] }, "noun": "armful of firewood", "glyph": "fire", "say": "Cut and carry firewood to the hearths." }
    },
