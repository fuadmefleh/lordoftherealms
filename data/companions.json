    "lines": {
        "approve": {
            "honour": ["\"That was done rightly. I'm proud to ride with you.\"", "\"Honour still means something on this road.\""],
            "piety": ["\"The gods saw that. They'll remember.\"", "\"A blessed deed. I'll light a candle for it.\""],
            "greed": ["\"Now that's the kind of business I like.\"", "\"Coin in the purse — a good day.\""],
            "compassion": ["\"You have a kind heart. Don't let the road harden it.\"", "\"People will sleep easier tonight because of you.\""],
            "ambition": ["\"Keep this up and they'll sing of us.\"", "\"That's how a name is made.\""],
            "freedom": ["\"Open roads and free folk — this is living.\"", "\"Nobody's chains today. Good.\""],
            "loyalty_kingdom": ["\"My homeland would thank you for that.\"", "\"You've been a friend to my people.\""],
            "loyalty_faith": ["\"The faithful will hear of this.\"", "\"You walk the true path.\""]
        },
        "disapprove": {
            "honour": ["\"I didn't swear to follow a liar and a coward.\"", "\"There's no honour in that, and you know it.\""],
            "piety": ["\"The gods turn their faces from such things.\"", "\"I'll be praying for your soul tonight.\""],
            "greed": ["\"Throwing good coin away. Again.\"", "\"Generosity is a fine word for waste.\""],
            "compassion": ["\"Those were people. Do you even remember their faces?\"", "\"I can't keep looking away from what you do.\""],
            "ambition": ["\"We ran. We RAN. Do you know what that costs a name?\"", "\"Small deeds make small lords.\""],
            "freedom": ["\"Chains and tithes and iron rule. I didn't come for this.\"", "\"Every gate you shut is one more cage.\""],
            "loyalty_kingdom": ["\"You've made enemies of my own people.\"", "\"My homeland won't forget this — and neither will I.\""],
            "loyalty_faith": ["\"You mock the faith with every step.\"", "\"The temple would be ashamed of you.\""]
        },
        "battleWin": ["\"Ha! Did you see them run?\"", "\"Another day we live. Drinks are on you.\"", "\"Not bad. Not bad at all.\""],
        "battleLoss": ["\"We'll lick our wounds. Next time.\"", "\"That was a slaughter. We need a better plan.\"", "\"I've seen better days — and better commanders.\""],
        "paid": ["\"Pay day. Much obliged.\""],
        "unpaid": ["\"Where's my wage? A promise doesn't fill a belly.\"", "\"No coin again. My patience has a bottom, you know.\""],
        "complain": ["\"We need to talk about how things are going.\"", "\"I'm not happy. Not by half.\"", "\"Don't think I haven't noticed what you've been doing.\""],
        "talkHappy": ["\"Glad to be on the road with you.\"", "\"Whatever comes, I've got your back.\"", "\"Tell me another story of the old days.\""],
        "talkContent": ["\"The road's long, but the company's decent.\"", "\"Could be worse. Could be raining.\""],
        "talkUnhappy": ["\"Talk won't fix this.\"", "\"Save your breath.\""],
        "gift": ["\"For me? ...Thank you. Truly.\"", "\"You didn't have to. But I'm glad you did.\""],
        "warning": ["{name} has been counting your purse with an odd look, and was seen talking quietly with strangers at the last inn."]
    },
