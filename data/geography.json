            "tongue": 0.35
        },
        "Woodland": {
            "roots": ["Green", "Fern", "Moss", "Willow", "Birch", "Dew", "Thrush", "Hazel", "Elder", "Bramble", "Fox", "Bluebell"],
            "tongue": 0.35,
            "nouns": { "lake": ["Mere", "Pool", "Water"], "forest": ["Weald", "Wood", "Greenwood", "Forest"] }
        },
        "Swamp": {
            "roots": ["Murk", "Bog", "Gloom", "Mire", "Rot", "Leech", "Toad", "Black", "Sunken", "Eel", "Stagnant", "Rush"],
            "tongue": 0.4,
            "nouns": { "lake": ["Pool", "Mere", "Water"], "marsh": ["Fens", "Mire", "Bogs", "Slough"] }
        },
        "Nordic": {
            "roots": ["Frost", "Wolf", "Raven", "Rime", "Storm", "Bear", "Troll", "Winter", "Thunder", "Ice", "Skald's", "Grim"],
            "tongue": 0.45,
            "nouns": { "lake": ["Vatn", "Loch", "Lake", "Mere"], "bay": ["Fjord", "Vik", "Bay"], "sound": ["Fjord", "Sound", "Firth"], "range": ["Fells", "Teeth", "Mountains", "Peaks"] }
        },
        "Mountain": {
            "roots": ["Anvil", "Hammer", "Deep", "Granite", "Forge", "Iron", "Copper", "Boulder", "Thunder", "Dwarf", "Flint", "Slate"],
            "tongue": 0.4,
            "nouns": { "range": ["Peaks", "Teeth", "Crags", "Mountains", "Spine"], "lake": ["Tarn", "Lake", "Loch"] }
        },
        "Nomadic": {
            "roots": ["Wind", "Horse", "Dust", "Sky", "Hawk", "Red", "Thunder", "Grass", "Bone", "Spear", "Eagle", "Khan's"],
